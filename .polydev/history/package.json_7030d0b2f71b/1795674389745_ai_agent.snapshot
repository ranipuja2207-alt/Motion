{
  "name": "motion-video",
  "version": "1.0.0",
  "description": "Remotion motion graphics video synced with voiceover",
  "type": "module",
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render src/index.ts MainComposition out/video.mp4 --codec h264 --crf 17 --overwrite",
    "still": "remotion still src/index.ts MainComposition out/frame.png --frame"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/transitions": "^4.0.0",
    "@remotion/motion-blur": "^4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config": "^4.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.3.0"
  }
}